# Copy to .env on the server and fill in. DO NOT commit the real .env.
#
# From the GitHub OAuth App (Settings > Developer settings > OAuth Apps):
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
#
# Long random string that signs login tokens. REQUIRED — the app refuses to
# start without it. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
#
# GitHub logins allowed to delete anyone's comment (comma-separated).
MODERATORS=ech08ravo
#
# Per-user write limits, requests per hour. Defaults shown.
RATE_LIMIT_COMMENTS=20
RATE_LIMIT_RATINGS=60
#
# Nightly SQLite snapshots. BACKUP_KEEP is how many to retain;
# set BACKUP_INTERVAL_SECONDS=0 to disable the backup task entirely.
BACKUP_DIR=/data/backups
BACKUP_KEEP=7
BACKUP_INTERVAL_SECONDS=86400
#
# Public base of this API (used to build the OAuth callback URL):
API_BASE=https://textbook-api.webgrid.online
#
# Where to send users after login, and which origins may call the API.
# Set these to your live GitHub Pages URL.
SITE_ORIGIN=https://ech08ravo.github.io
SITE_REDIRECT=https://ech08ravo.github.io/annotated-bibliography/
ALLOWED_ORIGINS=https://ech08ravo.github.io
