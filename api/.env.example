# Copy to .env on the server and fill in. DO NOT commit the real .env.
#
# From the GitHub OAuth App (Settings > Developer settings > OAuth Apps):
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
#
# Long random string that signs login tokens. REQUIRED — the app refuses to
# start without it. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
#
# GitHub logins allowed to delete anyone's comment (comma-separated).
MODERATORS=ech08ravo
#
# Per-user write limits, requests per hour. Defaults shown.
RATE_LIMIT_COMMENTS=20
RATE_LIMIT_RATINGS=60
RATE_LIMIT_SUBMISSIONS=10
#
# --- Paper submissions (POST /papers) ---------------------------------------
# Leave GITHUB_REPO or GITHUB_WRITE_TOKEN empty to keep submissions disabled;
# the endpoint then returns 503 and the site falls back to its GitHub PR flow.
#
# The repo papers are committed into, and a token with contents:write on it.
# A fine-grained PAT scoped to this one repository is enough:
#   GitHub > Settings > Developer settings > Personal access tokens >
#   Fine-grained tokens > Repository access: only this repo >
#   Permissions: Contents = Read and write
GITHUB_REPO=ech08ravo/annotated-bibliography
GITHUB_WRITE_TOKEN=
#
# Branch to commit onto. Point this at a review branch instead of main if you
# would rather submissions arrive as a pull request than land directly.
SUBMIT_BRANCH=main
#
# Restrict who may submit (comma-separated GitHub logins).
# Empty means any signed-in GitHub user may submit.
SUBMIT_ALLOWLIST=
#
# Largest accepted PDF upload, in bytes (default 10 MB).
MAX_PDF_BYTES=10485760
#
# Nightly SQLite snapshots. BACKUP_KEEP is how many to retain;
# set BACKUP_INTERVAL_SECONDS=0 to disable the backup task entirely.
BACKUP_DIR=/data/backups
BACKUP_KEEP=7
BACKUP_INTERVAL_SECONDS=86400
#
# Public base of this API (used to build the OAuth callback URL):
API_BASE=https://textbook-api.webgrid.online
#
# Where to send users after login, and which origins may call the API.
# Set these to your live GitHub Pages URL.
SITE_ORIGIN=https://ech08ravo.github.io
SITE_REDIRECT=https://ech08ravo.github.io/annotated-bibliography/
ALLOWED_ORIGINS=https://ech08ravo.github.io
